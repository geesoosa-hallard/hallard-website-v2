{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hallard-website-v2",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}