# Analytics stays off until these real IDs are supplied and consent is available.
VITE_GA_MEASUREMENT_ID=G-REPLACE_WITH_GA4_ID
VITE_CLARITY_PROJECT_ID=REPLACE_WITH_CLARITY_PROJECT_ID
VITE_ANALYTICS_CONSENT_REQUIRED=true

# Payments — Clover Payment Links are primary; Stripe is the fallback.
# Clover: create Payment Links in the Clover dashboard (Settings > Ecommerce > Payment links).
# These are PUBLIC hosted-checkout URLs. No API key or secret belongs in this static site.
VITE_CLOVER_STARTER_PAYMENT_LINK=
VITE_CLOVER_BUSINESS_PAYMENT_LINK=
VITE_CLOVER_BUSINESS_PLUS_PAYMENT_LINK=

# Stripe (fallback): create recurring Payment Links in Stripe, then place their https://buy.stripe.com/... URLs here.
VITE_STRIPE_STARTER_PAYMENT_LINK=https://buy.stripe.com/REPLACE_WITH_STARTER_LINK
VITE_STRIPE_BUSINESS_PAYMENT_LINK=https://buy.stripe.com/REPLACE_WITH_BUSINESS_LINK
VITE_STRIPE_BUSINESS_PLUS_PAYMENT_LINK=https://buy.stripe.com/REPLACE_WITH_BUSINESS_PLUS_LINK
